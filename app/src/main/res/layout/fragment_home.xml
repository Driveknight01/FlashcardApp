<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSearchBarWrapper"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_toStartOf="@+id/cardUserAvatarWrapper"
                android:layout_marginEnd="14dp"
                android:layout_centerVertical="true"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#EFEFEF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_search_category_default"
                        app:tint="#616161"/>

                    <EditText
                        android:id="@+id/edtHomeSearch"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Tìm kiếm"
                        android:textColor="#212121"
                        android:textColorHint="#757575"
                        android:textSize="16sp"
                        android:inputType="text"
                        android:importantForAutofill="no"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUserAvatarWrapper"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#4D62FF"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/txtAvatarLetter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="N"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>

        <TextView
            android:id="@+id/lblContinueStudy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Tiếp tục học"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardContinueStudy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#EAEAEA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/txtContinueDeckTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đang tải học phần..."
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressHomeDeck"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="24dp"
                    app:trackCornerRadius="4dp"
                    app:trackColor="#EAECEF"
                    app:indicatorColor="#4D62FF"/>

                <TextView
                    android:id="@+id/txtContinueProgressIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Đã học 0 / 0 thẻ"
                    android:textSize="14sp"
                    android:textColor="#616161"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnHomeContinueAction"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:text="Tiếp tục"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="#4D62FF"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="24dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/lblAdminGlobalDecks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Học phần hệ thống mới nhất"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAdminGlobalDecks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"/>

        <TextView
            android:id="@+id/lblRecentUserDecks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Đã học gần đây"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentUserDecks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>