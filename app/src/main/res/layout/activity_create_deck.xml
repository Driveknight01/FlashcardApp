<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:background="#F8F9FA">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCreate"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        app:title="Tạo học phần"
        app:titleTextColor="#212121"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:elevation="2dp"/>

    <LinearLayout
        android:id="@+id/lnHeaderInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbarCreate"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtDeckTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Chủ đề, chương, đơn vị (Tiêu đề)"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnGlobalOcrScan"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[+] Quét tài liệu (OCR)"
            android:textColor="#3F51B5"
            android:textStyle="bold"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCreateCards"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/lnHeaderInput"
        android:paddingBottom="88dp"
        android:clipToPadding="false"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddCardSlot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        android:src="@drawable/ic_add"
        android:backgroundTint="#3F51B5"
        app:tint="#FFFFFF"
        app:fabSize="normal"
        android:contentDescription="Thêm thẻ bằng tay"/>

</RelativeLayout>