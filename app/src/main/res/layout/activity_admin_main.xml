<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnFakeSearchContainer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="14dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#EFEFEF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cardAdminAvatarWrapper">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_search_category_default"
                    app:tint="#616161"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Tìm kiếm"
                    android:textColor="#757575"
                    android:textSize="16sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAdminAvatarWrapper"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#4D62FF"
            app:layout_constraintTop_toTopOf="@+id/btnFakeSearchContainer"
            app:layout_constraintBottom_toBottomOf="@+id/btnFakeSearchContainer"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:id="@+id/txtAdminAvatarLetter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="A"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/lblAdminTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Quản trị hệ thống"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#212121"
            app:layout_constraintTop_toBottomOf="@+id/btnFakeSearchContainer"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnMenuCreateDeck"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#4D62FF"
            app:layout_constraintTop_toBottomOf="@+id/lblAdminTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnMenuGlobalDecks">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="➕" android:textSize="18sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tạo mới" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnMenuGlobalDecks"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:layout_marginHorizontal="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#EAEAEA"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintTop_toTopOf="@+id/btnMenuCreateDeck"
            app:layout_constraintStart_toEndOf="@+id/btnMenuCreateDeck"
            app:layout_constraintEnd_toStartOf="@+id/btnMenuUserList">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📝" android:textSize="18sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sửa bộ thẻ" android:textColor="#212121" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnMenuUserList"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#EAEAEA"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintTop_toTopOf="@+id/btnMenuCreateDeck"
            app:layout_constraintStart_toEndOf="@+id/btnMenuGlobalDecks"
            app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👥" android:textSize="18sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quản lý User" android:textColor="#212121" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/lblTrendingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Nhiều lượt học nhất"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#212121"
            app:layout_constraintTop_toBottomOf="@+id/btnMenuCreateDeck"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAdminTrendingDecks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@+id/lblTrendingTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/lblMonitorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Vừa truy cập"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#212121"
            app:layout_constraintTop_toBottomOf="@+id/rvAdminTrendingDecks"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtActiveUserCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Top 5 hôm nay"
            android:textColor="#4D62FF"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="@+id/lblMonitorTitle"
            app:layout_constraintBottom_toBottomOf="@+id/lblMonitorTitle"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAdminActiveUsersToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@+id/lblMonitorTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>